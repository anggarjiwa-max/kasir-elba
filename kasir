<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Kasir Elba Prime — POS & Pembukuan Offline</title>
  <style>
    :root{
      --bg:#07111f;
      --bg2:#0f1e33;
      --card:rgba(255,255,255,.095);
      --card2:rgba(255,255,255,.14);
      --line:rgba(255,255,255,.14);
      --text:#f7fbff;
      --muted:#9fb0c5;
      --soft:#d7e3f4;
      --brand:#75e0c6;
      --brand2:#8ba7ff;
      --gold:#f4c870;
      --danger:#ff7a8a;
      --ok:#74e59a;
      --warning:#ffd36a;
      --shadow:0 24px 70px rgba(0,0,0,.35);
      --radius:22px;
      --radius2:14px;
    }
    *{box-sizing:border-box}
    body{
      margin:0;
      min-height:100vh;
      font-family:Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      color:var(--text);
      background:
        radial-gradient(circle at 15% 12%, rgba(117,224,198,.22), transparent 32%),
        radial-gradient(circle at 80% 8%, rgba(139,167,255,.22), transparent 30%),
        radial-gradient(circle at 65% 90%, rgba(244,200,112,.14), transparent 28%),
        linear-gradient(135deg, var(--bg), var(--bg2));
      overflow-x:hidden;
    }
    button,input,select,textarea{font:inherit}
    button{cursor:pointer}
    .hidden{display:none!important}
    .auth-wrap{
      min-height:100vh;
      display:grid;
      place-items:center;
      padding:28px;
      position:relative;
    }
    .orb{
      position:absolute;
      width:250px;
      height:250px;
      border-radius:50%;
      filter:blur(30px);
      opacity:.22;
      background:var(--brand);
      left:10%;
      top:10%;
      pointer-events:none;
    }
    .orb.two{background:var(--brand2);left:auto;right:9%;top:52%}
    .auth-card{
      width:min(1020px,100%);
      display:grid;
      grid-template-columns:1.1fr .9fr;
      gap:18px;
      background:rgba(255,255,255,.08);
      border:1px solid var(--line);
      box-shadow:var(--shadow);
      backdrop-filter:blur(22px);
      border-radius:32px;
      overflow:hidden;
    }
    .hero{
      padding:46px;
      background:
        linear-gradient(160deg, rgba(117,224,198,.14), rgba(139,167,255,.08)),
        rgba(255,255,255,.04);
      border-right:1px solid var(--line);
      min-height:560px;
      display:flex;
      flex-direction:column;
      justify-content:space-between;
    }
    .brand-mark{
      display:flex;align-items:center;gap:12px;font-weight:800;letter-spacing:.3px
    }
    .logo{
      width:48px;height:48px;border-radius:16px;
      display:grid;place-items:center;
      background:linear-gradient(135deg,var(--brand),var(--brand2));
      color:#07111f;font-weight:950;font-size:26px;
      box-shadow:0 14px 30px rgba(117,224,198,.24);
    }
    h1{font-size:clamp(38px,5vw,68px);line-height:.95;margin:24px 0 14px;letter-spacing:-2.5px}
    h2{margin:0 0 16px;font-size:24px;letter-spacing:-.5px}
    .lead{font-size:18px;color:var(--soft);max-width:560px;line-height:1.6}
    .pill-row{display:flex;gap:10px;flex-wrap:wrap;margin-top:24px}
    .pill{border:1px solid var(--line);background:rgba(255,255,255,.08);padding:10px 14px;border-radius:999px;color:var(--soft);font-size:13px}
    .auth-form{padding:34px;align-self:center}
    .form-card{background:rgba(7,17,31,.34);border:1px solid var(--line);border-radius:26px;padding:24px;box-shadow:0 16px 50px rgba(0,0,0,.2)}
    label{display:block;color:var(--muted);font-size:12px;font-weight:750;margin:12px 0 7px;text-transform:uppercase;letter-spacing:.08em}
    input,select,textarea{
      width:100%;
      border:1px solid var(--line);
      border-radius:14px;
      padding:13px 14px;
      background:rgba(255,255,255,.09);
      color:var(--text);
      outline:none;
      transition:.18s;
    }
    textarea{min-height:88px;resize:vertical}
    input:focus,select:focus,textarea:focus{border-color:rgba(117,224,198,.78);box-shadow:0 0 0 4px rgba(117,224,198,.12)}
    option{color:#0b1628;background:#fff}
    .btn{
      border:0;border-radius:14px;padding:12px 16px;font-weight:850;
      color:#07111f;background:linear-gradient(135deg,var(--brand),var(--brand2));
      box-shadow:0 14px 28px rgba(117,224,198,.18);
      transition:transform .15s, filter .15s;
    }
    .btn:hover{transform:translateY(-1px);filter:brightness(1.04)}
    .btn.secondary{color:var(--text);background:rgba(255,255,255,.1);border:1px solid var(--line);box-shadow:none}
    .btn.danger{color:#271013;background:linear-gradient(135deg,#ff9aa6,#ff687b);box-shadow:none}
    .btn.warn{color:#201604;background:linear-gradient(135deg,#ffe399,#f4c870);box-shadow:none}
    .btn.small{padding:8px 11px;border-radius:11px;font-size:12px}
    .muted{color:var(--muted)}
    .tiny{font-size:12px;color:var(--muted);line-height:1.5}
    .full{width:100%;margin-top:16px}
    .switcher{display:flex;background:rgba(255,255,255,.06);border:1px solid var(--line);border-radius:16px;padding:5px;margin-bottom:16px}
    .switcher button{flex:1;background:transparent;border:0;color:var(--muted);border-radius:12px;padding:10px;font-weight:800}
    .switcher button.active{background:rgba(255,255,255,.14);color:var(--text)}
    .app{display:grid;grid-template-columns:280px 1fr;min-height:100vh}
    aside{
      position:sticky;top:0;height:100vh;padding:22px;border-right:1px solid var(--line);
      background:rgba(7,17,31,.55);backdrop-filter:blur(24px);
    }
    .side-top{display:flex;align-items:center;gap:12px;margin-bottom:26px}
    .store-title{font-weight:900;line-height:1.15}
    .store-sub{font-size:12px;color:var(--muted);margin-top:4px}
    nav{display:grid;gap:8px}
    .nav-btn{
      border:1px solid transparent;background:transparent;color:var(--soft);display:flex;align-items:center;gap:11px;
      padding:12px 13px;border-radius:16px;font-weight:800;text-align:left;
    }
    .nav-btn:hover{background:rgba(255,255,255,.07)}
    .nav-btn.active{background:linear-gradient(135deg,rgba(117,224,198,.18),rgba(139,167,255,.16));border-color:var(--line);color:var(--text)}
    .side-footer{position:absolute;left:22px;right:22px;bottom:22px;display:grid;gap:10px}
    main{padding:24px 28px 42px;min-width:0}
    .topbar{display:flex;justify-content:space-between;gap:16px;align-items:center;margin-bottom:18px}
    .page-title{font-size:30px;font-weight:950;letter-spacing:-1.2px;margin:0}
    .page-sub{margin:5px 0 0;color:var(--muted)}
    .grid{display:grid;gap:16px}
    .grid.cards{grid-template-columns:repeat(4,minmax(0,1fr))}
    .grid.two{grid-template-columns:1.1fr .9fr}
    .grid.three{grid-template-columns:repeat(3,minmax(0,1fr))}
    .card{
      background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:18px;
      box-shadow:0 12px 34px rgba(0,0,0,.18);backdrop-filter:blur(20px);
    }
    .metric-title{color:var(--muted);font-size:13px;font-weight:800;text-transform:uppercase;letter-spacing:.08em}
    .metric-value{font-size:28px;font-weight:950;letter-spacing:-.8px;margin-top:8px}
    .metric-note{font-size:12px;color:var(--muted);margin-top:7px}
    .toolbar{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin:0 0 14px}
    .toolbar .grow{flex:1;min-width:210px}
    table{width:100%;border-collapse:collapse;overflow:hidden}
    th,td{text-align:left;padding:12px 10px;border-bottom:1px solid rgba(255,255,255,.09);vertical-align:top}
    th{color:var(--muted);font-size:12px;text-transform:uppercase;letter-spacing:.08em;font-weight:850}
    td{color:var(--soft);font-size:14px}
    tr:last-child td{border-bottom:0}
    .badge{display:inline-flex;align-items:center;gap:6px;padding:6px 9px;border-radius:999px;font-size:12px;font-weight:850;border:1px solid var(--line);color:var(--soft);background:rgba(255,255,255,.07)}
    .badge.ok{color:#c8ffd8;background:rgba(116,229,154,.12)}
    .badge.warn{color:#ffeab2;background:rgba(255,211,106,.13)}
    .badge.danger{color:#ffc3ca;background:rgba(255,122,138,.13)}
    .pos-layout{display:grid;grid-template-columns:minmax(0,1fr) 390px;gap:16px}
    .product-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(185px,1fr));gap:12px;max-height:calc(100vh - 210px);overflow:auto;padding-right:4px}
    .product-tile{padding:14px;border-radius:18px;background:rgba(255,255,255,.08);border:1px solid var(--line);display:flex;flex-direction:column;gap:10px;min-height:150px}
    .product-tile h3{font-size:15px;margin:0;line-height:1.25}
    .price{font-weight:950;color:#fff;font-size:18px}
    .cart{position:sticky;top:18px;align-self:start}
    .cart-items{display:grid;gap:9px;max-height:310px;overflow:auto;margin:12px 0}
    .cart-row{display:grid;grid-template-columns:1fr auto;gap:10px;padding:11px;border:1px solid var(--line);border-radius:16px;background:rgba(255,255,255,.07)}
    .qty{display:flex;gap:6px;align-items:center;justify-content:flex-end;margin-top:8px}
    .qty button{width:28px;height:28px;border-radius:9px;border:1px solid var(--line);background:rgba(255,255,255,.08);color:var(--text);font-weight:900}
    .sum-line{display:flex;justify-content:space-between;gap:10px;color:var(--soft);margin:9px 0}
    .sum-line.total{font-size:22px;color:var(--text);font-weight:950;border-top:1px solid var(--line);padding-top:12px;margin-top:12px}
    .modal-backdrop{position:fixed;inset:0;background:rgba(0,0,0,.62);display:grid;place-items:center;padding:20px;z-index:30}
    .modal{width:min(760px,100%);max-height:90vh;overflow:auto;background:#0b1628;border:1px solid var(--line);border-radius:28px;box-shadow:var(--shadow);padding:22px}
    .modal-head{display:flex;justify-content:space-between;gap:12px;align-items:center;margin-bottom:14px}
    .receipt{background:#fff;color:#111;border-radius:16px;padding:20px;font-family:ui-monospace, SFMono-Regular, Menlo, Consolas, monospace}
    .receipt h3{text-align:center;margin:0 0 4px;color:#111}
    .receipt p,.receipt div{color:#111;font-size:12px}
    .receipt .rline{border-top:1px dashed #888;margin:10px 0}
    .receipt table th,.receipt table td{color:#111;border-bottom:1px dashed #ddd;font-size:12px;padding:7px 3px}
    .toast{position:fixed;right:22px;bottom:22px;z-index:40;background:rgba(11,22,40,.94);border:1px solid var(--line);border-radius:18px;padding:14px 16px;box-shadow:var(--shadow);max-width:340px}
    .empty{text-align:center;color:var(--muted);padding:24px;border:1px dashed var(--line);border-radius:18px;background:rgba(255,255,255,.04)}
    .mobile-menu{display:none}
    .report-print{display:none}
    @media(max-width:1100px){
      .grid.cards{grid-template-columns:repeat(2,minmax(0,1fr))}
      .pos-layout,.grid.two{grid-template-columns:1fr}
      .cart{position:relative;top:auto}
      .product-grid{max-height:none}
    }
    @media(max-width:780px){
      .auth-card{grid-template-columns:1fr}
      .hero{min-height:auto;padding:30px;border-right:0;border-bottom:1px solid var(--line)}
      .auth-form{padding:20px}
      .app{grid-template-columns:1fr}
      aside{display:none}
      main{padding:16px}
      .mobile-menu{display:block;margin-bottom:14px}
      .grid.cards,.grid.three{grid-template-columns:1fr}
      .topbar{align-items:flex-start;flex-direction:column}
      th:nth-child(3),td:nth-child(3){display:none}
    }
    @media print{
      body{background:#fff;color:#111}
      body *{visibility:hidden!important}
      .printable,.printable *{visibility:visible!important}
      .printable{position:absolute;left:0;top:0;width:100%;background:#fff;color:#111}
      .no-print{display:none!important}
    }
  </style>
</head>
<body>
  <div id="auth" class="auth-wrap">
    <div class="orb"></div><div class="orb two"></div>
    <section class="auth-card">
      <div class="hero">
        <div>
          <div class="brand-mark"><div class="logo">E</div><div><b>Kasir Elba Prime</b><div class="store-sub">POS pribadi, premium, offline</div></div></div>
          <h1>Kasir rapi. Stok aman. Uang kebaca.</h1>
          <p class="lead">Aplikasi kasir dan pembukuan untuk jualan harian. Cocok untuk toko HP, warung, produk digital, atau usaha kecil yang butuh catatan bersih tanpa ribet.</p>
          <div class="pill-row">
            <span class="pill">Gratis untuk pribadi</span>
            <span class="pill">Tanpa server</span>
            <span class="pill">PIN lokal</span>
            <span class="pill">Export CSV & Backup</span>
          </div>
        </div>
        <p class="tiny">Catatan: data tersimpan di browser/perangkat ini. Rutin gunakan menu Backup supaya data aman saat pindah perangkat atau bersihkan browser.</p>
      </div>
      <div class="auth-form">
        <div class="form-card">
          <div class="switcher" id="authSwitcher">
            <button class="active" data-auth="login">Masuk</button>
            <button data-auth="setup">Buat Toko</button>
          </div>
          <div id="loginBox">
            <h2>Masuk Kasir</h2>
            <p class="tiny" id="loginHint">Masukkan PIN 6 digit kamu.</p>
            <label>PIN</label>
            <input id="loginPin" type="password" inputmode="numeric" maxlength="6" placeholder="••••••" />
            <button class="btn full" onclick="login()">Masuk</button>
            <button class="btn secondary full" onclick="showResetHelp()">Lupa PIN / Reset</button>
          </div>
          <div id="setupBox" class="hidden">
            <h2>Buat Akun Toko</h2>
            <label>Nama Toko / Usaha</label>
            <input id="setupStore" placeholder="Contoh: Elba Store" />
            <label>Nama Pemilik</label>
            <input id="setupOwner" placeholder="Contoh: Angga" />
            <label>PIN 6 digit</label>
            <input id="setupPin" type="password" inputmode="numeric" maxlength="6" placeholder="123456" />
            <button class="btn full" onclick="createAccount()">Buat Akun & Mulai</button>
          </div>
        </div>
      </div>
    </section>
  </div>

  <div id="app" class="app hidden">
    <aside>
      <div class="side-top">
        <div class="logo">E</div>
        <div>
          <div class="store-title" id="sideStore">Elba Store</div>
          <div class="store-sub" id="sideOwner">Pemilik</div>
        </div>
      </div>
      <nav id="nav"></nav>
      <div class="side-footer">
        <button class="btn secondary" onclick="lockApp()">Kunci Aplikasi</button>
        <button class="btn secondary" onclick="goSection('settings')">Pengaturan</button>
      </div>
    </aside>
    <main>
      <select id="mobileNav" class="mobile-menu" onchange="goSection(this.value)"></select>
      <div id="content"></div>
    </main>
  </div>

  <div id="modalRoot"></div>
  <div id="toast" class="toast hidden"></div>

  <script>
    const KEY = 'kasir_elba_prime_personal_v1';
    const rupiah = new Intl.NumberFormat('id-ID',{style:'currency',currency:'IDR',maximumFractionDigits:0});
    const menus = [
      ['dashboard','Dashboard','Ringkasan usaha hari ini'],
      ['pos','Kasir','Transaksi cepat'],
      ['products','Produk & Stok','Kelola barang'],
      ['books','Pembukuan','Uang masuk & keluar'],
      ['reports','Laporan','Analisis dan export'],
      ['settings','Pengaturan','Identitas toko']
    ];
    let db = loadDB();
    let current = 'dashboard';
    let cart = [];
    let editingProductId = null;

    function loadDB(){
      const raw = localStorage.getItem(KEY);
      if(!raw) return {store:null, products:[], transactions:[], books:[], createdAt:new Date().toISOString()};
      try{return JSON.parse(raw)}catch(e){return {store:null, products:[], transactions:[], books:[], createdAt:new Date().toISOString()}}
    }
    function saveDB(){localStorage.setItem(KEY, JSON.stringify(db));}
    function $(id){return document.getElementById(id)}
    function money(n){return rupiah.format(Number(n||0))}
    function num(v){return Number(String(v||'0').replace(/[^0-9.-]/g,''))||0}
    function today(){return new Date().toISOString().slice(0,10)}
    function dateTime(){return new Date().toLocaleString('id-ID',{dateStyle:'medium',timeStyle:'short'})}
    function byDate(item){return String(item.date||item.createdAt||'').slice(0,10)}
    function uid(prefix){return prefix + '-' + Date.now().toString(36) + Math.random().toString(36).slice(2,7).toUpperCase()}
    function invoice(){
      const d = new Date();
      return 'ELB-' + d.getFullYear() + String(d.getMonth()+1).padStart(2,'0') + String(d.getDate()).padStart(2,'0') + '-' + String(db.transactions.length+1).padStart(4,'0')
    }
    function toast(msg){
      $('toast').textContent = msg;
      $('toast').classList.remove('hidden');
      setTimeout(()=>$('toast').classList.add('hidden'),2600);
    }
    function escapeHTML(str){return String(str??'').replace(/[&<>'"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));}

    function init(){
      setupAuthSwitcher();
      if(db.store){
        $('authSwitcher').querySelector('[data-auth="setup"]').classList.add('hidden');
        $('loginHint').textContent = `Masuk ke ${db.store.name}.`;
        showAuth('login');
      } else {
        showAuth('setup');
      }
      renderNav();
    }
    function setupAuthSwitcher(){
      document.querySelectorAll('#authSwitcher button').forEach(btn=>btn.onclick=()=>showAuth(btn.dataset.auth));
    }
    function showAuth(type){
      document.querySelectorAll('#authSwitcher button').forEach(b=>b.classList.toggle('active', b.dataset.auth===type));
      $('loginBox').classList.toggle('hidden', type!=='login');
      $('setupBox').classList.toggle('hidden', type!=='setup');
    }
    function createAccount(){
      const name = $('setupStore').value.trim();
      const owner = $('setupOwner').value.trim();
      const pin = $('setupPin').value.trim();
      if(!name || !owner || !/^\d{6}$/.test(pin)) return toast('Isi nama toko, pemilik, dan PIN harus 6 digit.');
      db.store = {name, owner, pin, address:'', phone:'', note:'Terima kasih sudah belanja.', theme:'prime'};
      db.products = seedProducts();
      saveDB();
      unlockApp();
      toast('Akun toko berhasil dibuat.');
    }
    function seedProducts(){
      return [
        {id:uid('prd'),name:'Contoh Produk A',sku:'ELBA-A01',category:'Umum',cost:80000,price:100000,stock:5,minStock:2,createdAt:new Date().toISOString()},
        {id:uid('prd'),name:'Contoh Produk B',sku:'ELBA-B01',category:'Umum',cost:120000,price:150000,stock:3,minStock:1,createdAt:new Date().toISOString()}
      ];
    }
    function login(){
      if(!db.store) return showAuth('setup');
      if($('loginPin').value.trim() === db.store.pin){
        unlockApp();
        $('loginPin').value='';
      }else toast('PIN salah. Coba lagi.');
    }
    function unlockApp(){
      $('auth').classList.add('hidden');
      $('app').classList.remove('hidden');
      renderNav();
      goSection(current||'dashboard');
    }
    function lockApp(){
      $('app').classList.add('hidden');
      $('auth').classList.remove('hidden');
      showAuth('login');
    }
    function showResetHelp(){
      openModal(`<div class="modal-head"><h2>Reset aplikasi</h2><button class="btn secondary small" onclick="closeModal()">Tutup</button></div>
      <p class="muted">Kalau lupa PIN, kamu bisa reset semua data aplikasi. Pastikan kamu sudah punya file backup jika datanya penting.</p>
      <div class="toolbar"><button class="btn danger" onclick="hardReset()">Reset Semua Data</button><button class="btn secondary" onclick="closeModal()">Batal</button></div>`);
    }
    function hardReset(){
      if(confirm('Yakin reset semua data? Produk, transaksi, dan pembukuan akan hilang.')){
        localStorage.removeItem(KEY); location.reload();
      }
    }

    function renderNav(){
      const nav = $('nav');
      const mobile = $('mobileNav');
      if(!nav || !mobile) return;
      nav.innerHTML = menus.map(m=>`<button class="nav-btn ${current===m[0]?'active':''}" onclick="goSection('${m[0]}')"><span>${navIcon(m[0])}</span><span>${m[1]}</span></button>`).join('');
      mobile.innerHTML = menus.map(m=>`<option value="${m[0]}" ${current===m[0]?'selected':''}>${m[1]}</option>`).join('');
      if(db.store){$('sideStore').textContent=db.store.name; $('sideOwner').textContent=db.store.owner;}
    }
    function navIcon(id){return ({dashboard:'⌁',pos:'▣',products:'▤',books:'◇',reports:'◎',settings:'⚙'}[id]||'•')}
    function goSection(id){
      current = id; renderNav();
      const data = menus.find(m=>m[0]===id) || menus[0];
      $('content').innerHTML = `<div class="topbar"><div><h1 class="page-title">${data[1]}</h1><p class="page-sub">${data[2]}</p></div><div class="badge">${new Date().toLocaleDateString('id-ID',{weekday:'long',day:'numeric',month:'long',year:'numeric'})}</div></div>` + renderSection(id);
      bindSection(id);
    }
    function renderSection(id){
      if(id==='dashboard') return dashboardHTML();
      if(id==='pos') return posHTML();
      if(id==='products') return productsHTML();
      if(id==='books') return booksHTML();
      if(id==='reports') return reportsHTML();
      if(id==='settings') return settingsHTML();
      return '';
    }

    function summarize(start=today(), end=today()){
      const tx = db.transactions.filter(t=>byDate(t)>=start && byDate(t)<=end);
      const books = db.books.filter(b=>byDate(b)>=start && byDate(b)<=end);
      const sales = tx.reduce((s,t)=>s+num(t.total),0);
      const cogs = tx.reduce((s,t)=>s+t.items.reduce((a,i)=>a+num(i.cost)*num(i.qty),0),0);
      const gross = sales-cogs;
      const income = books.filter(b=>b.type==='income').reduce((s,b)=>s+num(b.amount),0);
      const expense = books.filter(b=>b.type==='expense').reduce((s,b)=>s+num(b.amount),0);
      const net = gross + income - expense;
      const itemsSold = tx.reduce((s,t)=>s+t.items.reduce((a,i)=>a+num(i.qty),0),0);
      return {tx, books, sales, cogs, gross, income, expense, net, itemsSold};
    }
    function dashboardHTML(){
      const s = summarize();
      const low = db.products.filter(p=>num(p.stock)<=num(p.minStock));
      const stockValue = db.products.reduce((a,p)=>a+num(p.cost)*num(p.stock),0);
      const lastTx = [...db.transactions].reverse().slice(0,6);
      return `<div class="grid cards">
        ${metric('Omzet Hari Ini',money(s.sales),`${s.tx.length} transaksi · ${s.itemsSold} item terjual`)}
        ${metric('Laba Kotor',money(s.gross),`Omzet dikurangi modal barang`)}
        ${metric('Laba Bersih Estimasi',money(s.net),`Sudah dihitung dengan kas masuk/keluar`)}
        ${metric('Nilai Stok Modal',money(stockValue),`${db.products.length} produk · ${low.length} stok menipis`)}
      </div>
      <div class="grid two" style="margin-top:16px">
        <div class="card"><h2>Transaksi Terakhir</h2>${lastTx.length?txTable(lastTx):empty('Belum ada transaksi. Mulai dari menu Kasir.')}</div>
