    function renderProductTiles(){
      const q = ($('posSearch')?.value||'').toLowerCase();
      const products = db.products.filter(p=>[p.name,p.sku,p.category].join(' ').toLowerCase().includes(q));
      $('productTiles').innerHTML = products.length ? products.map(p=>`<div class="product-tile">
