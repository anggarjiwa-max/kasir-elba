    function download(filename, text, type='text/csv'){
      const blob = new Blob([text], {type}); const url = URL.createObjectURL(blob); const a=document.createElement('a'); a.href=url; a.download=filename; a.click(); URL.revokeObjectURL(url);
    }
    function exportProductsCSV(){download('produk-kasir-elba.csv', toCSV([['Nama','SKU','Kategori','Modal','Harga','Stok','Min Stok'],...db.products.map(p=>[p.name,p.sku,p.category,p.cost,p.price,p.stock,p.minStock])]));}
    function exportBooksCSV(){download('pembukuan-kasir-elba.csv', toCSV([['Tanggal','Tipe','Kategori','Nominal','Catatan'],...db.books.map(b=>[b.date,b.type,b.category,b.amount,b.note])]));}
    function exportTransactionsCSV(){
      const rows=[['Tanggal','Invoice','Metode','Produk','Qty','Harga','Modal','Subtotal Item','Diskon Transaksi','Total Transaksi']];
      db.transactions.forEach(t=>t.items.forEach(i=>rows.push([t.date,t.invoice,t.method,i.name,i.qty,i.price,i.cost,i.total,t.discount,t.total])));
      download('transaksi-kasir-elba.csv', toCSV(rows));
    }
    function backupJSON(){download(`backup-kasir-elba-${today()}.json`, JSON.stringify(db,null,2), 'application/json')}
    function importJSON(e){
      const file=e.target.files[0]; if(!file) return;
      const reader=new FileReader();
      reader.onload=()=>{try{const next=JSON.parse(reader.result); if(!next.store||!Array.isArray(next.products)||!Array.isArray(next.transactions)||!Array.isArray(next.books)) throw new Error('format'); if(confirm('Import backup akan mengganti data saat ini. Lanjut?')){db=next;saveDB();location.reload();}}catch(err){toast('File backup tidak valid.')}};
      reader.readAsText(file);
    }
    function openModal(html){$('modalRoot').innerHTML=`<div class="modal-backdrop"><div class="modal">${html}</div></div>`}
    function closeModal(){$('modalRoot').innerHTML=''}
    document.addEventListener('keydown',e=>{if(e.key==='Escape')closeModal()});
    init();
  </script>
</body>
</html>
