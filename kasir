    function addToCart(id){
      const p = db.products.find(x=>x.id===id); if(!p) return;
      const row = cart.find(x=>x.id===id);
      const qtyNow = row ? row.qty : 0;
      if(qtyNow+1 > num(p.stock)) return toast('Stok tidak cukup.');
      if(row) row.qty += 1; else cart.push({id:p.id,name:p.name,sku:p.sku,price:num(p.price),cost:num(p.cost),qty:1});
      renderCart();
    }
    function cartSubTotal(){return cart.reduce((a,i)=>a+num(i.price)*num(i.qty),0)}
    function renderCart(){
      const items = $('cartItems'); if(!items) return;
      items.innerHTML = cart.length ? cart.map(i=>`<div class="cart-row"><div><b>${escapeHTML(i.name)}</b><div class="tiny">${money(i.price)} × ${i.qty} = ${money(i.price*i.qty)}</div><div class="qty"><button onclick="cartQty('${i.id}',-1)">−</button><b>${i.qty}</b><button onclick="cartQty('${i.id}',1)">+</button><button onclick="removeCart('${i.id}')">×</button></div></div><div>${money(i.price*i.qty)}</div></div>`).join('') : empty('Keranjang masih kosong.');
      const subtotal = cartSubTotal();
      const discount = Math.min(num($('discount')?.value), subtotal);
      const total = Math.max(0, subtotal-discount);
      const paid = num($('paid')?.value);
      $('cartSummary').innerHTML = `<div class="sum-line"><span>Subtotal</span><b>${money(subtotal)}</b></div><div class="sum-line"><span>Diskon</span><b>${money(discount)}</b></div><div class="sum-line total"><span>Total</span><span>${money(total)}</span></div><div class="sum-line"><span>Kembalian</span><b>${money(Math.max(0,paid-total))}</b></div>`;
    }
    function cartQty(id,delta){
      const row = cart.find(x=>x.id===id); if(!row) return;
      const p = db.products.find(x=>x.id===id);
      if(delta>0 && row.qty+1>num(p.stock)) return toast('Stok tidak cukup.');
      row.qty += delta;
      if(row.qty<=0) removeCart(id); else renderCart();
    }
    function removeCart(id){cart = cart.filter(x=>x.id!==id); renderCart()}
    function clearCart(){cart=[]; renderCart()}
    function checkout(){
      if(!cart.length) return toast('Keranjang masih kosong.');
      const subtotal = cartSubTotal();
      const discount = Math.min(num($('discount').value), subtotal);
      const total = Math.max(0, subtotal-discount);
      const paid = num($('paid').value) || total;
      const method = $('payMethod').value;
      if(method==='Cash' && paid<total) return toast('Nominal cash kurang dari total.');
      for(const i of cart){const p=db.products.find(x=>x.id===i.id); if(!p || i.qty>num(p.stock)) return toast(`Stok ${i.name} tidak cukup.`)}
      cart.forEach(i=>{const p=db.products.find(x=>x.id===i.id); p.stock=num(p.stock)-num(i.qty)});
      const tx = {id:uid('tx'),invoice:invoice(),items:cart.map(i=>({...i,total:i.price*i.qty})),subtotal,discount,total,paid,change:Math.max(0,paid-total),method,note:$('txNote').value.trim(),date:new Date().toISOString()};
      db.transactions.push(tx); saveDB();
      cart=[]; $('discount').value=0; $('paid').value=''; $('txNote').value='';
      renderProductTiles(); renderCart(); showReceipt(tx); toast('Transaksi tersimpan.');
    }
